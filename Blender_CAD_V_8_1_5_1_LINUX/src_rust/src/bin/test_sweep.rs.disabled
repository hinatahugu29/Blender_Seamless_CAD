#![recursion_limit = "512"]
use cpp::cpp;

cpp! {{
    #include <iostream>
    #include "occ_primitives.hpp"
    #include "occ_utils.hpp"
    #include <BRepBuilderAPI_MakePolygon.hxx>
    #include <BRepBuilderAPI_MakeFace.hxx>
    #include <BRepBuilderAPI_MakeEdge.hxx>
    #include <BRepBuilderAPI_MakeWire.hxx>
    #include <gp_Pnt.hxx>
    #include <TopoDS_Face.hxx>
    #include <TopoDS_Wire.hxx>
    #include <TopoDS_Solid.hxx>
    #include <TopAbs_ShapeEnum.hxx>
    #include <BRepPrimAPI_MakePrism.hxx>
    #include <BRepOffsetAPI_MakePipe.hxx>
    #include <BRepOffsetAPI_MakePipeShell.hxx>
    #include <BRepBuilderAPI_MakeSolid.hxx>
    #include <BRepBuilderAPI_Sewing.hxx>
    #include <ShapeFix_Shell.hxx>
}}

fn main() {
    cpp::cpp! {unsafe [] {
        // Create a rectangular profile
        BRepBuilderAPI_MakePolygon poly;
        poly.Add(gp_Pnt(0, -1, -1));
        poly.Add(gp_Pnt(0, 1, -1));
        poly.Add(gp_Pnt(0, 1, 1));
        poly.Add(gp_Pnt(0, -1, 1));
        poly.Close();
        
        BRepBuilderAPI_MakeFace mkFace(poly.Wire());
        TopoDS_Face profile = mkFace.Face();
        
        // Create a curved path (e.g. an arc or polyline)
        BRepBuilderAPI_MakePolygon pathPoly;
        pathPoly.Add(gp_Pnt(0, 0, 0));
        pathPoly.Add(gp_Pnt(5, 0, 0));
        pathPoly.Add(gp_Pnt(10, 5, 0));
        TopoDS_Wire path = pathPoly.Wire();
        
        // Test 1: MakePipe
        std::cout << "--- Testing BRepOffsetAPI_MakePipe ---" << std::endl;
        BRepOffsetAPI_MakePipe pipe(path, profile);
        TopoDS_Shape shape1 = pipe.Shape();
        std::cout << "MakePipe initial shape type: " << shape1.ShapeType() << std::endl;
        
        TopoDS_Shape firstFace = pipe.FirstShape();
        TopoDS_Shape lastFace = pipe.LastShape();
        
        if (!firstFace.IsNull() && firstFace.ShapeType() == TopAbs_FACE) {
            std::cout << "FirstShape is a face!" << std::endl;
            firstFace.Reverse();
        }
        
        BRepBuilderAPI_Sewing sewer(1e-4);
        sewer.Add(shape1);
        if (!firstFace.IsNull()) sewer.Add(firstFace);
        if (!lastFace.IsNull()) sewer.Add(lastFace);
        sewer.Perform();
        
        TopoDS_Shape sewn = sewer.SewedShape();
        std::cout << "Sewed shape type: " << sewn.ShapeType() << std::endl;
        
        if (sewn.ShapeType() == TopAbs_SHELL) {
            ShapeFix_Shell sf(TopoDS::Shell(sewn));
            sf.Perform();
            TopoDS_Shell fixedShell = sf.Shell();
            
            BRepBuilderAPI_MakeSolid mkSolid(fixedShell);
            if (mkSolid.IsDone()) {
                std::cout << "MakePipe + Sewing + ShapeFix -> SOLID created successfully!" << std::endl;
            } else {
                std::cout << "MakePipe + Sewing + ShapeFix -> FAILED to create SOLID." << std::endl;
            }
        }
        
        // Test 2: MakePipeShell with MakeSolid
        std::cout << "--- Testing BRepOffsetAPI_MakePipeShell ---" << std::endl;
        BRepOffsetAPI_MakePipeShell pipeShell(path);
        pipeShell.Add(profile);
        pipeShell.MakeSolid();
        TopoDS_Shape shape2 = pipeShell.Shape();
        std::cout << "MakePipeShell shape type: " << shape2.ShapeType() << std::endl;
        
    }};
}
